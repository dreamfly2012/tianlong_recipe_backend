# ============================================================
#  FTP 上传配置模板
#
#  用法:
#    1. 复制本文件: cp deploy/ftp.env.example deploy/ftp.env
#    2. 填写真实服务器信息
#    3. 打包并上传: bash deploy/pack.sh release --upload
#
#  说明: deploy/ftp.env 已被 .gitignore 忽略，且 pack.sh 打包时
#  会排除它，地址/密码不会进入 git，也不会打进发布包。
# ============================================================

# FTP 服务器地址（只写主机名或 IP，不要带 ftp:// 前缀）
FTP_HOST=ftp.example.com

# 端口（普通 FTP 默认 21）
FTP_PORT=21

# FTP 账号与密码（原样填写，不要加引号；支持 $ # 空格 等字符）
FTP_USER=your_username
FTP_PASS=your_password

# 上传到服务器的目标目录（FTP 路径，相对于 FTP 登录根目录，以 / 开头）
# 留空或填 / 表示登录根目录（宝塔 FTP 账号通常就是站点根目录）
# 该目录必须对 FTP 账号可写；上传报 553 一般是目录不可写，可在服务器执行:
#   chown "$(stat -c '%u:%g' storage)" <站点根目录>
FTP_DIR=/

# 是否强制 FTPS（FTP over TLS）: 1 = 要求加密连接，0 = 普通 FTP
FTP_SSL=0
