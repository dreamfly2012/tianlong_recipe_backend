APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recipe
DB_USERNAME=root
DB_PASSWORD=123456

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


COS_APP_ID=xxx
COS_SECRET_ID=xx
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_CDN=
COS_PATH_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== AI 大模型（recipe.generate 实时生成菜谱，OpenAI 兼容协议）=====
# 网关地址，可指向 OpenAI / DeepSeek / 本地兼容网关（如 http://localhost:20128/v1）
AI_BASE_URI=http://localhost:20128/v1
# 密钥
AI_API_KEY=
# 模型名（本地网关 freem 是免费 combo，会自动路由到 minimax-m2.5 / qwen3-coder-next 等后端）
AI_MODEL=freem
# 请求超时（秒）
AI_TIMEOUT=60
# 是否启用 json_object 响应格式（部分本地网关不支持可设为 false，靠 prompt 约束 + 解析容错）
AI_JSON_MODE=false

# Unsplash 图库（AI 生成菜谱时按菜名自动配图，可选）
# 注意：填 Access Key（不是 Secret key）；且 images.unsplash.com 在部分网络不可达
UNSPLASH_ACCESS_KEY=
UNSPLASH_TIMEOUT=15
# 图片下载兜底代理（Unsplash CDN 不可达时经此转存）
IMAGE_PROXY_BASE=https://wsrv.nl/?url={url}&w=1200&output=jpg
# Pexels 备用图源（推荐：其 API 与图片 CDN 国内均可直连，免费 key 见 pexels.com/api）
PEXELS_API_KEY=
PEXELS_TIMEOUT=20
# 外部图源都失败时是否退回本地图（库内同名菜谱图 / placeholder.jpg）
IMAGE_LOCAL_FALLBACK=true
